        + '</div>'
        + '<div id="target-row" class="steppers hidden"><div class="stp"><span class="sl">target seconds</span>'
          + '<div class="sv"><button type="button" onclick="bump(\'dur-target\',-15)">&minus;</button>'
          + '<input id="dur-target" type="number" inputmode="numeric" step="1" value="'+esc(v('dur-target',target))+'">'
          + '<button type="button" onclick="bump(\'dur-target\',15)">+</button></div></div></div>'
        + '<div class="dur-display" id="dur-display">0:00</div>'
        + '<div class="dur-controls">'
          + '<button type="button" class="dur-start" id="dur-start" onclick="durStart()">Start</button>'
          + '<button type="button" class="dur-stop hidden" id="dur-stop" onclick="durStop('+e.id+',\''+jsStr(tt)+'\')">Stop &amp; log</button>'
