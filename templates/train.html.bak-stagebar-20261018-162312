        const dist = spec.distance ? '<div class="stp txt"><span class="sl">distance m</span>'
            + '<div class="sv"><button type="button" onclick="bump(\'ws-dist\',-100)">&minus;</button>'
            + '<input id="ws-dist" type="number" inputmode="numeric" step="1" value="'+esc(v('ws-dist',''))+'">'
            + '<button type="button" onclick="bump(\'ws-dist\',100)">+</button></div></div>' : '';
        const setting = spec.setting ? '<div class="stp txt"><span class="sl">setting</span>'
            + '<div class="sv"><input id="ws-setting" type="text" value="'+esc(v('ws-setting',''))+'" placeholder="level"></div></div>' : '';
        if(dist||setting) extra = '<div class="steppers'+(dist&&setting?' two':'')+'">'+dist+setting+'</div>';
    }
    return extra
        + '<div class="dur-modes">'
          + '<button type="button" id="mode-endure" onclick="setDurMode(\'endure\')">Endure &#9650;</button>'
