function logButton(e,tt){
    const n = setsFor(e.id).length + 1;
    return '<button type="button" class="log-btn" id="log-tick" onclick="logSet('+e.id+',\''+jsStr(tt)+'\')">'
        + 'Log set '+n+'</button>';
}

// The Fa Jin offer: one row, under the logger, ignorable. It replaces the
// modal that fired on selection (REVIEW §2.2) — with nothing covering the
// screen there is no snooze state, no offered-once guard and no per-day
// dismissal store to keep in sync with the server's training day.
function renderFajinRow(e){
    if(e.is_fajin || e.muscle_group==='cardio') return '';   // never a Fa Jin for a Fa Jin
    const exact = FAJIN.find(f=>f.muscle_group===e.muscle_group && f.function===e.function);
    const fb = exact || FAJIN.find(f=>f.muscle_group===e.muscle_group);
    if(!fb) return '';
    if(setsFor(fb.id).length) return '';                     // already done today — don't nag
    const meta = EX_BY_ID[fb.id] || {};
    const d = meta.days_since;
    return '<button type="button" class="fajin-row" onclick="openExercise('+fb.id+')">'
        + '<span class="fk">Fa Jin</span>'
        + '<span class="fnm">'+esc(fb.name)+'</span>'
        + '<span class="fv">'+(exact ? esc(fb.function_label||'') : 'same muscle')
          + (d!==null&&d!==undefined?' · '+dayLabel(d):'')+'</span>'
        + '<span class="fp">&rsaquo;</span></button>';
}

function renderAll(){ renderStatus(); renderCoverage(); renderCard(); updateFajinPill(); }

// ── Steppers ──────────────────────────────────────────────────────────────
// Per-field stepping rules. Reps, distance and the target are integers (reps
// used to inherit the float path, so +1 on 2.5 gave 3.5 reps); man-dur holds
// mm:ss. (REVIEW §1.15)
const INT_FIELDS = new Set(['ws-r','ws-dist','dur-target']);
function bump(id,delta){
    const el=document.getElementById(id); if(!el) return;
    if(id==='man-dur'){
        const cur=parseDuration(el.value);
        const base=isNaN(cur)?0:cur;
        const next=Math.max(0, base+delta);
        el.value = next ? fmtDur(next) : '';
        return;
    }
    let v=parseFloat(el.value)||0;
    v=Math.max(0,Math.round((v+delta)*100)/100);
    el.value = INT_FIELDS.has(id) ? Math.round(v) : v;
    if(id==='ws-w' || id==='ws-r') renderCard();   // keeps the e1RM/PR tag live
}

// ── Duration timer (lifted from the old exercise sheet, unchanged) ────────
let durMode='endure', durT0=null, durTick=null, durTargetFired=false;
function setDurMode(m){ durMode=m; durReset(); setDurModeUI(m); }
function setDurModeUI(m){
    const e=document.getElementById('mode-endure'), t=document.getElementById('mode-target'),
          row=document.getElementById('target-row');
    if(e) e.classList.toggle('active',m==='endure');
    if(t) t.classList.toggle('active',m==='target');
    if(row) row.classList.toggle('hidden', m!=='target');
}
function durDisplay(sec){ const d=document.getElementById('dur-display'); if(!d) return;
    const m=Math.floor(sec/60), ss=String(Math.abs(sec%60)).padStart(2,'0'); d.textContent=m+':'+ss; }
function durStart(){
    if(durT0) return;                 // already running — a second tap must not restart it
    const st=document.getElementById('dur-start'), sp=document.getElementById('dur-stop');
    if(!st || !sp) return;            // card was rebuilt out from under the tap
    durTargetFired=false;
    const d=document.getElementById('dur-display'); if(d) d.classList.remove('fire');
    st.classList.add('hidden');
    sp.classList.remove('hidden');
    durT0=Date.now(); clearInterval(durTick); durLoop(); durTick=setInterval(durLoop,200);
}
function durLoop(){
    if(!durT0){ clearInterval(durTick); return; }   // sheet was rebuilt under us
    const elapsed=Math.floor((Date.now()-durT0)/1000);
    if(durMode==='endure'){ durDisplay(elapsed); }
    else {
        const targetEl=document.getElementById('dur-target');
        const target=targetEl?(parseInt(targetEl.value)||0):0;
        const remain=target-elapsed;
        // Past the target, count the overrun up rather than sitting on 0:00 —
        // otherwise there is no way to tell a 10s hold from a 90s one.
        durDisplay(remain>=0 ? remain : -remain);
        const d=document.getElementById('dur-display');
        if(d) d.classList.toggle('over', remain<0);
        if(remain<=0 && !durTargetFired){ durTargetFired=true; fireTargetCue(); }
    }
}
// The rest countdown and the work timer are different instruments; the cue
// must flash the one that actually finished.
function fireRestCue(){
    const t=document.getElementById('rest-time'); if(t) t.classList.add('fire');
    beepCue();
}
function fireTargetCue(){
    const d=document.getElementById('dur-display'); if(d) d.classList.add('fire');
    beepCue();
}
function beepCue(){
    try { const ctx=new (window.AudioContext||window.webkitAudioContext)();
        const o=ctx.createOscillator(), g=ctx.createGain(); o.connect(g); g.connect(ctx.destination);
        o.frequency.value=880; g.gain.value=0.15; o.start();
        setTimeout(()=>{o.frequency.value=1320;},180); setTimeout(()=>{o.stop();ctx.close();},420);
    } catch(e){}
    try { if(navigator.vibrate) navigator.vibrate([120,60,120]); } catch(e){}
}
async function durStop(id,tt){
    clearInterval(durTick);
    if(!durT0){ return; }                      // Stop tapped with no run in flight
    const elapsed=Math.floor((Date.now()-durT0)/1000);
    durT0=null;
    let secs = elapsed;
    if(durMode==='target'){
        const target = parseInt((document.getElementById('dur-target')||{}).value)||0;
        // Stopping early in Target mode logged the FULL target, crediting work
        // that wasn't done. Log whichever is smaller. (REVIEW §1.7)
        secs = target>0 ? Math.min(target, elapsed) : elapsed;
    }
    const stopBtn=document.getElementById('dur-stop'), startBtn=document.getElementById('dur-start');
    if(stopBtn) stopBtn.classList.add('hidden');
    if(startBtn) startBtn.classList.remove('hidden');
    if(secs<=0){ toast('Timer ran for less than a second — not logged.'); return; }
    await logSet(id, tt, {duration_s:secs});
}
// renderCard() re-emits the timer controls in their idle state, but durT0 and
// durTick survive the rebuild. Without this the clock keeps counting while
// Start is showing and Stop is gone, durStart() refuses to restart, and the
// set can only be logged by typing the duration by hand. Reachable three ways:
// a kg stepper tap on weight_time, tapping a logged row, or the phone locking
// and resyncLive() firing. REVIEW §1.6's invariant, broken through a new door.
function restoreDurUI(){
    if(!durT0) return;
    const st=document.getElementById('dur-start'), sp=document.getElementById('dur-stop');
    if(st) st.classList.add('hidden');
    if(sp) sp.classList.remove('hidden');
    clearInterval(durTick); durLoop(); durTick=setInterval(durLoop,200);
}
function durReset(){ clearInterval(durTick); durT0=null; durTargetFired=false;
    const d=document.getElementById('dur-display'); if(d){d.textContent='0:00'; d.classList.remove('fire','over');}
    const s=document.getElementById('dur-start'), st=document.getElementById('dur-stop');
    if(s)s.classList.remove('hidden'); if(st)st.classList.add('hidden');
}
// Accepts "90", "1:30" or "1:30:00" and returns seconds (NaN when unparseable).
function parseDuration(raw){
    const t=String(raw==null?'':raw).trim();
    if(!t) return 0;
    if(!/^\d+(:\d{1,2}){0,2}$/.test(t)) return NaN;
    const parts=t.split(':').map(Number);
    if(parts.some(n=>!isFinite(n))) return NaN;
    if(parts.length===1) return parts[0];
    if(parts.length===2) return parts[0]*60 + parts[1];
    return parts[0]*3600 + parts[1]*60 + parts[2];
}
function manualDuration(){
    const el=document.getElementById('man-dur');
    const secs = parseDuration(el ? el.value : '');
    if(isNaN(secs)){ toast('Duration should look like 90 or 1:30'); return null; }
    if(secs<=0){ toast('Enter a duration, or use the timer.'); return null; }
    if(secs>86400){ toast('That duration looks wrong.'); return null; }
    return secs;
}
function logTimedManual(id,tt){ const s=manualDuration(); if(s===null) return; logSet(id, tt, {duration_s:s}); }
function logCardioManual(id){ const s=manualDuration(); if(s===null) return; logSet(id, 'cardio', {duration_s:s}); }

// ── Logging ───────────────────────────────────────────────────────────────
let logInFlight = false;
async function logSet(id, tt, extra){
    if(logInFlight) return;          // a double tap must not log twice (REVIEW §1.3)
    extra = extra || {};
    const btn=document.getElementById('log-tick');
    const body=dateBody({ exercise_id:id, successful:true });
    if(tt==='weight_reps' || tt==='weight_time'){ body.weight_kg = parseFloat((document.getElementById('ws-w')||{}).value)||0; }
    if(tt==='weight_reps' || tt==='reps'){
        body.reps = parseInt((document.getElementById('ws-r')||{}).value)||0;
        if(body.reps<=0){ toast('Enter reps'); return; }
    }
    if(extra.duration_s!=null){ body.duration_s=extra.duration_s; }
    if(tt==='cardio'){
        const dEl=document.getElementById('ws-dist'), sEl=document.getElementById('ws-setting');
        if(dEl && dEl.value) body.distance_m=parseInt(dEl.value)||0;
        if(sEl && sEl.value) body.setting=sEl.value.trim();
    }

    const label = btn ? btn.textContent : '';
    if(btn){ btn.classList.remove('failed','saved'); btn.classList.add('saving');
             btn.textContent='Saving…'; btn.disabled=true; }
    logInFlight = true;
    let r;
    try { r = await apiPost('/api/gym/log-set', body); }
    finally { logInFlight = false; if(btn) btn.disabled=false; }

    if(r.ok && r.data.ok){
        LIVE = r.data.workout_so_far;
        if(btn){ btn.classList.remove('saving'); btn.classList.add('saved'); btn.textContent='✓ Saved'; }
        const e = EX_BY_ID[id];
        // Cardio is continuous work, not sets with rest between them.
        if(e && e.muscle_group!=='cardio') startRest(e.rest_s || 90);
        durReset();
        setTimeout(()=>{ if(CURRENT===id) renderAll(); }, 550);
        renderStatus(); renderCoverage();
    } else {
        // Explicit failed state + retry — the set is not dropped from intent.
        // A 4xx means the server will never accept this set, so don't dress it
        // up as a retry; only a network drop or a 5xx is worth tapping again.
        const retryable = r.offline || r.status===0 || r.status>=500;
        if(btn){ btn.classList.remove('saving'); btn.classList.add('failed');
            btn.textContent = retryable ? '✕ Failed — tap to retry' : '✕ ' + saveErr(r);
            if(retryable) btn.onclick=()=>{ btn.textContent=label; logSet(id,tt,extra); }; }
        toast(saveErr(r));
    }
}

// Tapping a logged row loads its numbers back into the steppers, so correcting
// a mistyped set is: load, fix, remove the bad one, log again.
function editSet(setId){
    const s=(LIVE.sets||[]).find(x=>x.id===setId); if(!s) return;
    const w=document.getElementById('ws-w'), r=document.getElementById('ws-r'),
          d=document.getElementById('man-dur');
    if(w && s.weight_kg!=null) w.value=fmtW(s.weight_kg);
    if(r && s.reps) r.value=s.reps;
    if(d && s.duration_s) d.value=fmtDur(s.duration_s);
    renderCard();
    toast('Set '+(s.n||'')+' loaded — remove it if you are replacing it.');
}

// Delete is the one destructive control here and the page cannot use confirm()
// (the artifact/webview frame no-ops it), so the safety net is an undo that
// actually works rather than a dialog. Same double-tap discipline as logSet.
let removeInFlight=false;
async function removeSet(setId, exId){
    if(removeInFlight) return;
    const s=(LIVE.sets||[]).find(x=>x.id===setId);
    removeInFlight = true;
    let r;
    try { r = await apiPost('/api/gym/set/delete', dateBody({set_id:setId})); }
    finally { removeInFlight = false; }

    if(r.ok && r.data.ok){
        LIVE=r.data.workout_so_far;
        renderAll();
        if(!r.data.removed){ toast('That set was already gone.'); return; }
        if(s) toast('Set removed.', {label:'Undo', fn:()=>relogSet(s)});
        else  toast('Set removed.');
    } else {
        toast(r.offline ? 'No connection — set not removed' : (r.data.error||'Could not remove that set'));
    }
}
// Undo re-logs the set through the normal path, so it lands at the end of the
// exercise's list rather than back in its old position. That is honest about
// what happened and avoids inventing an update endpoint for it.
async function relogSet(s){
    const body=dateBody({exercise_id:s.exercise_id, successful:true});
    if(s.weight_kg!=null) body.weight_kg=s.weight_kg;
    if(s.reps) body.reps=s.reps;
    if(s.duration_s) body.duration_s=s.duration_s;
    if(s.distance_m) body.distance_m=s.distance_m;
    if(s.setting) body.setting=s.setting;
    const r=await apiPost('/api/gym/log-set', body);
    if(r.ok && r.data.ok){ LIVE=r.data.workout_so_far; renderAll(); toast('Set restored.'); }
    else toast(saveErr(r));
}

// ── Choosing an exercise ──────────────────────────────────────────────────
async function openExercise(id){
    const e = EX_BY_ID[id]; if(!e) return;
    CURRENT = id; PREFILL = null; durReset(); durMode='endure';
    closePicker(); closeFajin();
    renderAll();
    const r = await apiGet(withDate('/api/gym/exercise/'+id+'/prefill'));
    // A failed prefill degrades to the bank's own tracking_type with no
    // reference values rather than blocking the logger.
    if(r.ok && r.data.ok && CURRENT===id){ PREFILL = r.data; renderAll(); }
}

// ── Picker sheet: search, continue, recent, browse ────────────────────────
function openPicker(scope){
    PICK_SCOPE = scope || null; PICK_Q=''; PICK_BROWSE = (scope==='cardio') ? 'cardio' : null;
    renderPicker();
    document.getElementById('pick-sheet').classList.add('on');
    // Deliberately NOT focusing the search box: on a phone the keyboard then
    // covers the recents, which is what you want 90% of the time.
}
function closePicker(){ document.getElementById('pick-sheet').classList.remove('on'); }
function renderPicker(){
    document.getElementById('pick-panel').innerHTML =
        '<div class="sheet-h"><span class="sheet-title">'
        + (PICK_SCOPE==='cardio' ? 'Cardio' : 'Choose exercise') + '</span>'
        + '<button type="button" class="sheet-close" onclick="closePicker()">&#10005;</button></div>'
        + (PICK_SCOPE==='cardio'
            ? '<div class="sheet-sub" style="margin:0 0 8px">Separate from lifting · pick a modality</div>'
            : '<div class="srch"><span style="color:var(--dimmer);font-family:var(--font-mono)">&#8981;</span>'
              + '<input id="pick-q" type="text" placeholder="Search exercises" autocomplete="off" '
              + 'oninput="onPickQuery(this.value)" value="'+esc(PICK_Q)+'"></div>')
        + '<div id="pick-results">'+pickResults()+'</div>';
}
function onPickQuery(v){ PICK_Q=v; document.getElementById('pick-results').innerHTML = pickResults(); }

function pickRow(e, meta, cls){
    return '<button type="button" class="pick" style="--g:'+mgColor(e.muscle_group)+'" onclick="openExercise('+e.id+')">'
        + '<span class="dot"></span><span class="pcol"><span class="pn">'+esc(e.name)+'</span>'
        + '<span class="pg">'+esc((e.muscle_label||e.muscle_group||'')+' · '+(e.function_label||e.function||''))+'</span></span>'
        + '<span class="pm'+(cls||'')+'">'+esc(meta)+'</span></button>';
}
function allLoggable(){
    return Object.keys(EX_BY_ID).map(k=>EX_BY_ID[k]).filter(e=>!e.is_fajin);
}
// The picker is scoped, and the scopes do not overlap: cardio is reachable
// ONLY through the Cardio button, and never shows up in search, recents or
// browse on the lifting side. That separation is the point of giving cardio
// its own door — letting it drift back into the general list would quietly
// undo it.
function pickPool(){
    return allLoggable().filter(e => PICK_SCOPE==='cardio'
        ? e.muscle_group==='cardio' : e.muscle_group!=='cardio');
}
function pickGroups(){
    return BANK.filter(g => PICK_SCOPE==='cardio' ? g.key==='cardio' : g.key!=='cardio');
}
function pickResults(){
    const q = PICK_Q.trim().toLowerCase();
    if(q){
        const hits = pickPool().filter(e=>e.name.toLowerCase().indexOf(q)>=0).slice(0,16);
        if(!hits.length) return '<div class="empty-note">Nothing matches “'+esc(PICK_Q)+'”</div>';
        return '<div class="sect">'+hits.length+' match'+(hits.length>1?'es':'')+'</div>'
            + hits.map(e=>{ const d=exDays(e);
                return pickRow(e, dayLabel(d), d===0?' live':((d===null||d>=7)?' stale':'')); }).join('');
    }
    if(PICK_BROWSE){
        const g = BANK.find(x=>x.key===PICK_BROWSE);
        if(!g) return '<div class="empty-note">Nothing in that group.</div>';
        return (PICK_SCOPE==='cardio' ? '' : '<button type="button" class="back-btn" onclick="setBrowse(null)">&lsaquo; All groups</button>')
            + g.functions.map(fn => '<div class="sect">'+esc(fn.label)+'</div>'
                + fn.exercises.map(x=>{ const e=EX_BY_ID[x.id], d=exDays(e);
                    return pickRow(e, dayLabel(d), d===0?' live':((d===null||d>=7)?' stale':'')); }).join('')).join('');
    }
    // Default view: what you already started, then what you reached for most
    // recently — freshest first, because mid-session you are coming back to
    // something, not shopping for the stalest thing in the bank.
    const started=[];
    const inScope = new Set(pickPool().map(e=>e.id));
    (LIVE.sets||[]).forEach(s=>{ if(s.exercise_id!==CURRENT && started.indexOf(s.exercise_id)<0
        && inScope.has(s.exercise_id)) started.push(s.exercise_id); });
    const cont = started.length
        ? '<div class="sect">Continue</div>' + started.map(id =>
            pickRow(EX_BY_ID[id], setsFor(id).length+' sets', ' live')).join('')
        : '';
    const recent = pickPool()
        .filter(e=>e.id!==CURRENT && started.indexOf(e.id)<0 && e.days_since!==null && e.days_since!==undefined)
        .sort((a,b)=>a.days_since-b.days_since).slice(0,5);
    const groups = pickGroups().map(g=>{
        const hit=groupSetCount(g.key), cov=COVERAGE.find(c=>c.key===g.key);
        const d = cov ? cov.days_since : null;
        return '<button type="button" class="pick" style="--g:'+mgColor(g.key)+'" onclick="setBrowse(\''+jsStr(g.key)+'\')">'
            + '<span class="dot"></span><span class="pcol"><span class="pn">'+esc(g.label)+'</span>'
            + '<span class="pg">'+g.functions.length+' function'+(g.functions.length===1?'':'s')+'</span></span>'
            + '<span class="pm'+(hit?' live':((d===null||d>=7)?' stale':''))+'">'
            + (hit ? hit+' today' : dayLabel(d))+'</span></button>';
    }).join('');
    return cont
        + (recent.length ? '<div class="sect">Recent</div>'
            + recent.map(e=>pickRow(e, dayLabel(exDays(e)))).join('') : '')
        + '<div class="sect">Browse by group</div>' + groups;
}
function setBrowse(k){ PICK_BROWSE=k; document.getElementById('pick-results').innerHTML = pickResults(); }

// ── Fa Jin list (the manual entry point — ignores every suppression) ──────
function updateFajinPill(){
    document.getElementById('fajin-cta').classList.toggle('hidden', FAJIN.length===0);
}
function openFajinList(){
    document.getElementById('fajin-panel').innerHTML =
        '<div class="sheet-h"><span class="sheet-title">Fa Jin</span>'
        + '<span class="sheet-sub">Explosive work</span>'
        + '<button type="button" class="sheet-close" onclick="closeFajin()">&#10005;</button></div>'
        + FAJIN.map(f=>{ const e=EX_BY_ID[f.id], d=e?exDays(e):null, done=setsFor(f.id).length;
            return pickRow(Object.assign({}, f, {muscle_label:f.muscle_label}),
                           done?done+' today':dayLabel(d), done?' live':''); }).join('');
    document.getElementById('fajin-sheet').classList.add('on');
}
function closeFajin(){ document.getElementById('fajin-sheet').classList.remove('on'); }

// ── Plate maths ──────────────────────────────────────────────────────────
// bar_kg rides the exercise's engagement blob (same place target_s lives), so
// an exercise without one simply says so rather than guessing from its name.
const PLATES = [25,20,15,10,5,2.5,1.25];
function openPlates(){
    const e=curEx(); if(!e) return;
    const w=parseFloat((document.getElementById('ws-w')||{}).value)||0;
    let body;
    if(!e.bar_kg){
        body = '<div class="empty-note">No bar weight set for this exercise.<br>'
             + 'Add <code>bar_kg</code> to it in the databank to get plate maths here.</div>';
    } else if(w <= e.bar_kg){
        body = '<div class="plate"><span class="pl">Bar</span><span class="pp">'+fmtW(e.bar_kg)+' kg</span></div>'
             + '<div class="empty-note">Target is at or under the bar — nothing to load.</div>';
    } else {
        let side=(w-e.bar_kg)/2; const counts={};
        PLATES.forEach(p=>{ while(side >= p-0.001){ counts[p]=(counts[p]||0)+1; side=Math.round((side-p)*100)/100; } });
        body = '<div class="plate"><span class="pl">Bar</span><span class="pp">'+fmtW(e.bar_kg)+' kg</span></div>'
             + Object.keys(counts).sort((a,b)=>b-a).map(k=>
                 '<div class="plate"><span class="pl">'+k+' kg</span><span class="pp">&times; '+counts[k]+' per side</span></div>').join('')
             + (side>0.01 ? '<div class="plate"><span class="pl" style="color:var(--red)">Unloadable</span>'
                 + '<span class="pp" style="color:var(--red)">'+fmtW(Math.round(side*200)/100)+' kg short</span></div>' : '');
    }
    document.getElementById('plate-panel').innerHTML =
        '<div class="sheet-h"><span class="sheet-title">Loading '+fmtW(w)+' kg</span>'
        + '<button type="button" class="sheet-close" onclick="closePlates()">&#10005;</button></div>'
        + body + '<button type="button" class="log-btn sec" onclick="closePlates()">Close</button>';
    document.getElementById('plate-sheet').classList.add('on');
}
function closePlates(){ document.getElementById('plate-sheet').classList.remove('on'); }

// ── Session summary + finish ─────────────────────────────────────────────
// end_gym_session() has existed since the session tables were added but
// nothing ever called it, so ended_at was only ever stamped days late by the
// lazy roll-over. (REVIEW §2.3)
let finishArmed=false;
function openSummary(){
    finishArmed=false;
    renderSummary();
    document.getElementById('sum-sheet').classList.add('on');
}
function armFinish(){ finishArmed=true; renderSummary(); }
function renderSummary(){
    const sets=LIVE.sets||[], v=volume();
    const byG={};
    sets.forEach(s=>{ const k=s.muscle_group||'other';
        if(!byG[k]) byG[k]={n:0, names:[]};
        byG[k].n++; if(byG[k].names.indexOf(s.exercise_name)<0) byG[k].names.push(s.exercise_name); });
    const lift = Object.keys(byG).filter(k=>k!=='cardio').map(k=>
        '<div class="sumrow" style="--g:'+mgColor(k)+'"><span class="sg">'+esc(k)+'</span>'
        + '<span class="sx">'+esc(byG[k].names.join(', '))+'</span>'
        + '<span class="sn">'+byG[k].n+'</span></div>').join('');
    // Cardio is reported on its own line, in minutes — never folded into
    // lifting volume, because it is a different kind of work.
    const cSecs = sets.filter(s=>s.muscle_group==='cardio').reduce((a,s)=>a+(s.duration_s||0),0);
    const cardio = cSecs ? '<div class="sumrow" style="--g:'+mgColor('cardio')+'">'
        + '<span class="sg">Cardio</span><span class="sx">'+esc(byG.cardio.names.join(', '))+'</span>'
        + '<span class="sn">'+Math.round(cSecs/60)+' min</span></div>' : '';
    const missing = COVERAGE.filter(g=>g.every_session && !groupSetCount(g.key)).map(g=>g.label);
    const vol = v>=1000 ? (v/1000).toFixed(1)+'k' : Math.round(v);

    document.getElementById('sum-panel').innerHTML =
        '<div class="sheet-h"><span class="sheet-title">Session</span>'
        + '<span class="sheet-sub">'+(LIVE.session_id?('#'+LIVE.session_id):'not started')+'</span>'
        + '<button type="button" class="sheet-close" onclick="closeSummary()">&#10005;</button></div>'
        + '<div class="sumgrid">'
          + '<div class="sumcell"><div class="sv">'+sets.length+'</div><div class="sk">Sets</div></div>'
          + '<div class="sumcell"><div class="sv">'+vol+'</div><div class="sk">Volume kg</div></div>'
          + '<div class="sumcell"><div class="sv">'+Object.keys(byG).length+'</div><div class="sk">Groups</div></div>'
        + '</div>'
        + (lift+cardio || '<div class="empty-note">No sets logged yet.</div>')
        + (missing.length ? '<div class="sect">Still outstanding</div>'
            + '<div class="sumrow warn"><span class="sx">'+esc(missing.join(', '))
            + ' — every-session groups not hit</span></div>' : '')
        + (LIVE.session_id
            ? (finishArmed
                ? '<button type="button" class="log-btn danger" onclick="finishSession()">Tap again to finish</button>'
                  + '<div class="finish-note">Closes the session. Logging another set re-opens it.</div>'
                : '<button type="button" class="log-btn" onclick="armFinish()">Finish session</button>')
            : '')
        + '<button type="button" class="log-btn sec" onclick="closeSummary()">Keep going</button>';
}
function closeSummary(){ finishArmed=false; document.getElementById('sum-sheet').classList.remove('on'); }
async function finishSession(){
    finishArmed=false;
    // dateBody: a back-dated day finishes THAT day's session, not today's.
    const r=await apiPost('/api/gym/session/finish', dateBody({}));
    if(r.ok && r.data.ok){
        closeSummary(); stopRest();
        LIVE = r.data.workout_so_far || LIVE;
        renderAll();
        toast('Session finished.');
    } else { toast(r.offline ? 'No connection — not finished' : (r.data.error||'Could not finish the session')); }
}

// ── Re-sync when the page comes back ──────────────────────────────────────
// A phone locks mid-workout, or the same session is open on a second device.
// Without this the page keeps rendering whatever LIVE was at load time, so a
// set logged elsewhere (or a roll-over past 4 AM) never shows up and the
// counts silently drift from the database.
let resyncing = false;
async function resyncLive(){
    if(resyncing || logInFlight) return;
    resyncing = true;
    try {
        const r = await apiGet(withDate('/api/gym/live-session'));
        if(r.ok && r.data && Array.isArray(r.data.sets)){
            LIVE = r.data;
            if(!Array.isArray(LIVE.muscles)) LIVE.muscles = [];
            renderAll();
        }
    } finally { resyncing = false; }
}
document.addEventListener('visibilitychange', ()=>{
    if(document.visibilityState==='visible') resyncLive();
});
window.addEventListener('pageshow', e=>{ if(e.persisted) resyncLive(); });

// ── Init ──────────────────────────────────────────────────────────────────
// Open on where the session left off; failing that, on the thing lifted most
// recently, so the page is never a blank shell waiting for a decision.
(function init(){
    if(!Array.isArray(LIVE.sets)) LIVE.sets = [];
    if(!Array.isArray(LIVE.muscles)) LIVE.muscles = [];
    renderDateHeader();
    let start = LIVE.current_exercise_id;
    if(!start || !EX_BY_ID[start]){
        const pool = allLoggable().filter(e=>e.muscle_group!=='cardio'
            && e.days_since!==null && e.days_since!==undefined);
        pool.sort((a,b)=>a.days_since-b.days_since);
        start = pool.length ? pool[0].id : null;
    }
    readRest();
    if(start) openExercise(start); else renderAll();
})();
</script>
{% endblock %}
