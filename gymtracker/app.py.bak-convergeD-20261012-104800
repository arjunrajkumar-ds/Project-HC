def _fmt_date(iso_str):
    """'2026-05-22' -> 'Fri 22 May'"""
    try:
        from datetime import date as _d
        d = _d.fromisoformat(iso_str)
        return f"{_DAYS[d.weekday()]} {d.day} {_MONTHS[d.month-1]}"
